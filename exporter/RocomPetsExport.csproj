<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>rocom-pets-export</AssemblyName>
    <RootNamespace>RocomPets.Export</RootNamespace>
    <!-- CUE4Parse 克隆位置:环境变量 CUE4PARSE_DIR 覆盖,默认 ~/Git/gh/CUE4Parse -->
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$([System.Environment]::GetEnvironmentVariable('CUE4PARSE_DIR'))</CUE4ParseDir>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/Git/gh/CUE4Parse</CUE4ParseDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本须与 CUE4Parse 的 Directory.Packages.props 锁定一致 -->
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <!-- CUE4Parse-Conversion 只带 SkiaSharp 托管层,Linux 原生库要另配(PNG 编码用) -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <!-- CUE4Parse 传递引用的 9.0.0 有漏洞通告(NU1903),顶层钉到修复版 -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
  </ItemGroup>

</Project>
