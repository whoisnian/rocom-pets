+        // 于是三个分量被搅成一个数,X/Y/Z 取出来彼此相等 —— 高精度切线基(FPackedRGBA16N)
+        // 正是经这里降到 8 位的,法线与切线因此变成同一个向量。
+        private static uint Quantize(float v) => (uint) Math.Clamp((int) ((v + 1f) * 127.5f), 0, 255);
